# Copy to config.env (git-ignored) and fill in. Environment variables override this file.

# The gateway's keys: the pair clients encrypt their assertions to, and the pair that signs the access tokens
# (ADR-0025). Path of a JWK Set file kept outside the repository and the image; the management API does not start
# without one of each. Create them with:
#   python -m ops.gateway_key generate <file>
#   python -m ops.gateway_key generate-signing <file>
GATEWAY_KEYS_FILE=
# What clients put in the aud of their assertions. Use the public URL of the management API.
GATEWAY_AUDIENCE=
# Other addresses the API is called at, comma-separated, for the htu of the DPoP proofs (ADR-0033). The audience is
# always one of them. In development, for example http://127.0.0.1:5002.
GATEWAY_URLS=
# The key service that holds the master key (an OpenBao). Each client's data is encrypted with a key it wraps;
# until it answers, whatever needs a key gets a 503. Outside development the address must be https.
ANDVARI_ADDR=
ANDVARI_ROLE_ID=
# Path of the file with the AppRole secret id, and of the CA that signed the key service's certificate.
ANDVARI_SECRET_ID_FILE=
ANDVARI_CA_FILE=
# Only for the command that issues the response engine's keys (python -m ops.engine_keys): the operator's client
# id and the AppRole `motor-claves` of Andvari, made by motor/instalar.sh of the andvari repository. The rest of what
# it reads (GATEWAY_URL, GATEWAY_PUBLIC_KEYS_FILE, OPERATOR_KEY_FILE, ENGINE_KEYS_SECRET_ID_FILE) is set by the
# compose for its run.
OPERATOR_CLIENT_ID=
ENGINE_KEYS_ROLE_ID=
# Where the register of erasures is kept: every deletion is written there before it is made, so that it can be
# made again after a backup of the database is restored. A directory that outlives the container, is backed up,
# and is not the database. While it cannot be written, nothing is deleted. Default: erasures
ERASURES_DIR=
# Meta App Secret (App Dashboard > App settings > Basic). Verifies X-Hub-Signature-256 on the webhook.
# Optional only if every chatbot document carries its own appSecret.
FACEBOOK_APP_SECRET=

CLIENT_ID=
NATIONAL_ID_URL=

DB_NAME=
DB_HOST=
DB_USERNAME=
DB_PASSWORD=
# Optional. How long a query, a connection or the choice of a server may wait before it fails (500 to 30000 ms,
# 5000 by default), and how long a connection may sit idle before it is closed (60000 ms by default).
# DB_TIMEOUT_MS=5000
# DB_MAX_IDLE_MS=60000

SENDER_EMAIL=
SENDER_PASSWORD=

GMAIL_SERVER_URL=
GMAIL_SERVER_PORT=

EXPIRATION_TIME=
ACTIVATION_CODE_LENGTH=
PASSWORD_LENGTH=

QMS_SERVER=
QMS_USER=
QMS_PASSWORD=

# The event bus, Bifröst (ADR-0019). The same names as the file Bifröst writes for each service, so
# /srv/infra/bifrost/credenciales/<service>.env can be handed to the container as it is. Without NATS_URL there is
# no publisher. Outside development the address must be tls://.
NATS_URL=
NATS_USER=
NATS_PASSWORD=
NATS_CA=
NATS_INBOX_PREFIX=

# Traces (OpenTelemetry, docs/03-implementation/trazas.md). Where to send them over OTLP/HTTP, for instance
# http://collector:4318. Without it they never leave the process. OTEL_SERVICE_NAME names each service.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=

KEY_SIZE=3072
PRIVATE_KEY_FILENAME=certs/{UUID}_private.pem
PUBLIC_KEY_FILENAME=certs/{UUID}_public.pem

# development | staging | production
ENVIRONMENT=development
VERSION=0.0.1

VERIFY_TOKEN=

# Templates: {fb_id} and {ACCESSTOKEN} / {version} and {PhoneNumberId} are filled in by the app.
FACEBOOK_GRAPH_URL=
FACEBOOK_WHATSAPP_MESSAGE=
FACEBOOK_GRAPH_VERSION=v19.0
